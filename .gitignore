.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*

# Gradle / Kotlin
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
out/
.kotlin/

# Frontend
node_modules/
dist/

