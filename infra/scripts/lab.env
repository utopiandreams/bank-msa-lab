# cluster-*.sh 공통 설정 (비밀값 없음)
# Raycast 등은 PATH가 짧아서 Homebrew 경로를 직접 넣는다
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

PVE_HOST="root@172.30.1.200"
PVE_IP="172.30.1.200"
PVE_MAC="22:02:4d:07:2d:06"          # enp5s0 (Wake-on-LAN 대상)
BROADCAST="172.30.1.255"

CP_VMID=230
WORKER_VMIDS=(231 232 233)

export KUBECONFIG="${HOME}/.kube/bank-msa-lab.yaml"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=3 -o LogLevel=ERROR)

pve() { ssh "${SSH_OPTS[@]}" "$PVE_HOST" "export LC_ALL=C; $*"; }
pve_up() { ssh "${SSH_OPTS[@]}" "$PVE_HOST" true >/dev/null 2>&1; }
ts() { date +%H:%M:%S; }
