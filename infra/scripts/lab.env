# cluster-*.sh 공통 설정 (비밀값 없음)
# Raycast 등은 PATH가 짧아서 Homebrew 경로를 직접 넣는다
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

PVE_HOST="root@172.30.1.200"
PVE_IP="172.30.1.200"
PVE_MAC="22:02:4d:07:2d:06"          # enp5s0 (Wake-on-LAN 대상)
BROADCAST="172.30.1.255"

# 두 번째 Proxmox 호스트 (2026-11-17 설치). 아직 VM 없음. up/down 대상 (2026-11-18부터, 호스트 단위 제어)
PVE2_HOST="root@172.30.1.201"
PVE2_IP="172.30.1.201"
PVE2_MAC="e8:9c:25:3d:77:19"         # nic0 (Wake-on-LAN 대상, 노드 확장 때 cluster-up.sh에 추가)

# 컨트롤 플레인 중재자 노트북 (2026-11-18 설치). 항상 켜 두는 장비라 up/down 대상이 아니다
WITNESS_HOST="ubuntu@172.30.1.202"
WITNESS_IP="172.30.1.202"

# 관측·관리 화면 (Raycast에서 Chrome으로 연다)
ARGOCD_URL="http://argocd.172.30.1.240.nip.io"
GRAFANA_URL="http://grafana.172.30.1.240.nip.io"

CP_VMID=230
CP_IP="172.30.1.230"                 # k3s 서버 (kubeconfig의 API 서버 주소)
WORKER_VMIDS=(231 232 233)

export KUBECONFIG="${HOME}/.kube/bank-msa-lab.yaml"

SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=3 -o LogLevel=ERROR)

pve() { ssh "${SSH_OPTS[@]}" "$PVE_HOST" "export LC_ALL=C; $*"; }
pve_up() { ssh "${SSH_OPTS[@]}" "$PVE_HOST" true >/dev/null 2>&1; }
pve2() { ssh "${SSH_OPTS[@]}" "$PVE2_HOST" "export LC_ALL=C; $*"; }
witness() { ssh "${SSH_OPTS[@]}" "$WITNESS_HOST" "export LC_ALL=C; $*"; }
# via_witness <user@host> <명령> → 노트북을 점프 호스트로 거쳐 SSH (키는 맥북 것을 그대로 씀, 노트북엔 안 둠)
via_witness() { local h=$1; shift; ssh "${SSH_OPTS[@]}" -J "$WITNESS_HOST" "$h" "export LC_ALL=C; $*"; }
ts() { date +%H:%M:%S; }

# ── 호스트 단위 켜기/끄기 (cluster-up.sh · cluster-down.sh) ──────────────
# Raycast는 /bin/bash 3.2로 돌 수 있어서 연관 배열 없이 case로 표를 만든다.
# 노트북(bank-cp3)은 항상 켜 두는 중재자라 여기 없다 (상태만 cluster-status.sh에서 본다)
LAB_HOSTS="proxmox proxmox2"

# host_info <이름> → H_NAME H_IP H_MAC H_SSH 설정
host_info() {
  case "$1" in
    proxmox)  H_NAME=proxmox;  H_IP=$PVE_IP;  H_MAC=$PVE_MAC;  H_SSH=$PVE_HOST ;;
    proxmox2) H_NAME=proxmox2; H_IP=$PVE2_IP; H_MAC=$PVE2_MAC; H_SSH=$PVE2_HOST ;;
    *) return 1 ;;
  esac
}
host_ssh() { ssh "${SSH_OPTS[@]}" "$H_SSH" "export LC_ALL=C; $*"; }

# resolve_targets <all|이름...> → 대상 호스트 이름 목록 (잘못된 이름이면 실패)
resolve_targets() {
  local t out=""
  [ $# -eq 0 ] && set -- all
  for t in "$@"; do
    if [ "$t" = all ]; then out="$out $LAB_HOSTS"
    elif host_info "$t"; then out="$out $t"
    else echo "알 수 없는 대상: $t (all | ${LAB_HOSTS// / | })" >&2; return 1
    fi
  done
  echo $out
}

# 출력 줄 앞에 [시각] [호스트]를 붙인다. 병렬로 돌아 줄이 섞여도 누구 얘기인지 보이게
log() { echo "[$(ts)] [$H_NAME] $*"; }
