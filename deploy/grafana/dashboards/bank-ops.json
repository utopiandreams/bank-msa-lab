    {
      "type": "stat",
      "id": 2,
      "title": "끝난 송금 (선택 기간)",
      "description": "선택한 기간 동안 끝 상태(COMPLETED·FAILED·CANCELLED)가 된 송금 수 (커밋된 것만). transfer_finished_total",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(transfer_finished_total[$__range]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
